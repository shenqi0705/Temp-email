# 服务器配置
PORT=3000
NODE_ENV=development

# 邮箱域名配置
DOMAIN=tempmail.local

# 数据库配置
DATABASE_PATH=./emails.db

# SMTP 配置（可选，用于真实邮件接收）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# API 配置
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=900000

# 邮箱配置
DEFAULT_MAILBOX_EXPIRES_IN=3600
MAX_MAILBOX_EXPIRES_IN=86400
